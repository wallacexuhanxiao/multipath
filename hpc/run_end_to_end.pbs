#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N oracle_end_to_end
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:20:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H200
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
: "${MULTIPATH_SCHEDULE:?existing static oracle schedule}"
: "${MULTIPATH_TRIPLET:?TACO triplet}"
: "${MULTIPATH_SEQUENCE:?TACO sequence}"
: "${MULTIPATH_RUN_NAME:?unique run name}"
OUT=$ROOT/outputs/$MULTIPATH_RUN_NAME
mkdir -p "$OUT/cache"
cd "$ROOT"
export TACO_ROOT=$RUNTIME/data/taco_v1
export MANO_ROOT=$RUNTIME/sources/reproduction/data/models/mano_smplx
export PYTHONPATH=$ROOT/src:$ENGINE/src
export PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
module load singularity
if [[ ! -d "${MULTIPATH_IMPORT_ROOT:-}" ]]; then
 source "$ROOT/hpc/stage_torch_imports.sh"
fi
MP_ENV=( --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib --env "XDG_CACHE_HOME=$OUT/cache"
 --bind "$MULTIPATH_IMPORT_ROOT:$MULTIPATH_IMPORT_ROOT:ro"
 --env "PYTHONPATH=$MULTIPATH_IMPORT_ROOT:$ROOT/deps:$ROOT/src" --env PYTHONDONTWRITEBYTECODE=1 --env PYTHONNOUSERSITE=1
 --env OMNI_KIT_ACCEPT_EULA=YES --env "PBS_JOBID=${PBS_JOBID:-unknown}"
 --env OMP_NUM_THREADS=2 --env OPENBLAS_NUM_THREADS=2 --env MKL_NUM_THREADS=2
 --bind "$ROOT/hpc/container_env/92-env-torch-distributed.sh:/.singularity.d/env/92-env-torch-distributed.sh:ro" )
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
"$RUNTIME/envs/retarget/bin/python" - "$OUT/sim_prefix.json" singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u <<'PY'
import json,sys
with open(sys.argv[1],'w') as stream:json.dump(sys.argv[2:],stream)
PY
EXTRA=()
[[ -z "${MULTIPATH_PREPARED_PROPOSALS:-}" ]] || EXTRA+=(--prepared-proposals "$MULTIPATH_PREPARED_PROPOSALS")
[[ -z "${MULTIPATH_SEED_ARTIFACTS:-}" ]] || EXTRA+=(--seed-artifacts "$MULTIPATH_SEED_ARTIFACTS")
[[ -z "${MULTIPATH_INITIAL_BRIDGE_RUN:-}" ]] || EXTRA+=(--initial-bridge-run "$MULTIPATH_INITIAL_BRIDGE_RUN")
[[ -z "${MULTIPATH_RESUME_DIVERSITY_BANK:-}" ]] || EXTRA+=(--resume-diversity-bank "$MULTIPATH_RESUME_DIVERSITY_BANK")
[[ -z "${MULTIPATH_TEMPLATE_ARTIFACTS:-}" ]] || EXTRA+=(--template-artifacts "$MULTIPATH_TEMPLATE_ARTIFACTS" --template-proposals "$MULTIPATH_TEMPLATE_PROPOSALS")
"$RUNTIME/envs/retarget/bin/python" -u scripts/run_end_to_end.py \
 --schedule "$MULTIPATH_SCHEDULE" --triplet "$MULTIPATH_TRIPLET" --sequence "$MULTIPATH_SEQUENCE" \
 --mount-report configs/franka_xhand_mount.json --floating-config configs/floating_xhand.json \
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" --object-cache "$ENGINE/outputs/sim_usd" \
 --sim-prefix "$OUT/sim_prefix.json" --output-dir "$OUT" "${EXTRA[@]}" \
 --mpc-candidates "${MULTIPATH_MPC_CANDIDATES:-16}" --mpc-iters "${MULTIPATH_MPC_ITERS:-2}" \
 --ppo-updates "${MULTIPATH_PPO_UPDATES:-20}" --max-attempts "${MULTIPATH_MAX_ATTEMPTS:-10}" \
 --solutions-per-interval "${MULTIPATH_SOLUTIONS_PER_INTERVAL:-3}" >"$OUT/run.log" 2>&1
