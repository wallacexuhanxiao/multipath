#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N anchor_startup
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:20:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H200
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
 : "${MULTIPATH_SCHEDULE:?oracle schedule}"
: "${MULTIPATH_PROPOSALS:?existing local proposals}"
: "${MULTIPATH_SNAPSHOT:?physically acquired entry}"
: "${MULTIPATH_CONTROLS:?local replay controls}"
: "${MULTIPATH_RUN_NAME:?unique experiment name}"
OUT=$ROOT/outputs/$MULTIPATH_RUN_NAME
mkdir -p "$OUT/cache"
cd "$ROOT"
module load singularity
source "$ROOT/hpc/stage_torch_imports.sh"
MP_ENV=( --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env "TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib" --env "XDG_CACHE_HOME=$OUT/cache"
 --bind "$MULTIPATH_IMPORT_ROOT:$MULTIPATH_IMPORT_ROOT:ro"
 --env "PYTHONPATH=$MULTIPATH_IMPORT_ROOT:$ROOT/deps:$ROOT/src" --env PYTHONDONTWRITEBYTECODE=1 --env PYTHONNOUSERSITE=1 --env OMNI_KIT_ACCEPT_EULA=YES
 --env "PBS_JOBID=${PBS_JOBID:-unknown}" )
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
# Equivalent MASTER_PORT arithmetic without a Bash subprocess that sources
# NVIDIA's GPU-probing BASH_ENV during Apptainer environment initialization.
MP_ENV+=(--bind "$ROOT/hpc/container_env/92-env-torch-distributed.sh:/.singularity.d/env/92-env-torch-distributed.sh:ro")
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u scripts/diagnose_anchor_startup.py \
 --proposals "$MULTIPATH_PROPOSALS" --schedule "$MULTIPATH_SCHEDULE" --snapshot "$MULTIPATH_SNAPSHOT" --controls "$MULTIPATH_CONTROLS" \
 --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml" \
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" --object-cache "$ENGINE/outputs/sim_usd" \
 --steps 48 --case bounded_arm_hand --output-dir "$OUT" >"$OUT/run.log" 2>&1
