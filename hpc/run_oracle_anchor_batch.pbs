#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N oracle_anchor_batch
#PBS -j oe
#PBS -k oed
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H100
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
 : "${MULTIPATH_SCHEDULE:?oracle schedule}"
: "${MULTIPATH_PROPOSALS:?existing local proposals}"
: "${MULTIPATH_PREDECESSOR:?first Anchor acquired predecessor}"
: "${MULTIPATH_COMMAND_TRACE:?historical actual control trace}"
: "${MULTIPATH_RUN_NAME:?unique experiment name}"
OUT=$ROOT/outputs/$MULTIPATH_RUN_NAME
mkdir -p "$OUT/cache"
cd "$ROOT"
module load singularity
MP_ENV=( --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env "TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib" --env "XDG_CACHE_HOME=$OUT/cache"
 --env "PYTHONPATH=$ROOT/deps:$ROOT/src" --env PYTHONNOUSERSITE=1 --env OMNI_KIT_ACCEPT_EULA=YES
 --env "PBS_JOBID=${PBS_JOBID:-unknown}" )
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
COMMON=( --proposals "$MULTIPATH_PROPOSALS" --schedule "$MULTIPATH_SCHEDULE"
 --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml"
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" --object-cache "$ENGINE/outputs/sim_usd" )
run_sim() {
 singularity exec --nv -e "${MP_ENV[@]}" --env "XDG_CACHE_HOME=$OUT/cache/$BASHPID" --env OMP_NUM_THREADS=2 --env OPENBLAS_NUM_THREADS=2 --env MKL_NUM_THREADS=2 "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u "$@"
}
mkdir -p "$OUT/anchors"
# This list comes from the oracle schedule; no sequence/frame-specific branches.
mapfile -t ANCHORS < <("$RUNTIME/envs/retarget/bin/python" -c 'import json,sys; print("\n".join(a["id"] for a in sorted(json.load(open(sys.argv[1]))["anchors"],key=lambda a:a["core_start"])))' "$MULTIPATH_SCHEDULE")
connect_prefix() {
 if [[ -f "$OUT/anchors/${ANCHORS[0]}/report.json" && ${#ANCHORS[@]} -gt 1 ]]; then
  run_sim scripts/run_oracle_v0.py "${COMMON[@]}" --validated-anchors "$OUT/anchors" \
   --continue-development --through-anchor "${ANCHORS[1]}" --output-dir "$OUT/$1" >"$OUT/$1.log" 2>&1 || true
 fi
}
# One interactive allocation; independent mounted processes use separate caches.
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
(
 run_sim scripts/develop_mounted_anchor.py "${COMMON[@]}" --anchor "${ANCHORS[0]}" \
  --predecessor-dir "$MULTIPATH_PREDECESSOR" --artifact-dir "$OUT/anchors" --output-dir "$OUT/${ANCHORS[0]}" >"$OUT/${ANCHORS[0]}.log" 2>&1 || true
 connect_prefix prefix_first
) &
PIDS=("$!")
if [[ ${#ANCHORS[@]} -gt 1 ]]; then
 run_sim scripts/acquire_anchor_snapshots.py "${COMMON[@]}" --command-trace "$MULTIPATH_COMMAND_TRACE" \
  --anchors "${ANCHORS[@]:1}" --output-dir "$OUT/acquisition" >"$OUT/acquisition.log" 2>&1 || true
fi
for anchor in "${ANCHORS[@]:1}"; do
 (
  predecessor="$OUT/acquisition"
  # Prefer an actual continuous predecessor when already available.
  if PYTHONPATH="$ROOT/src" "$RUNTIME/envs/retarget/bin/python" - "$MULTIPATH_SCHEDULE" "$MULTIPATH_PROPOSALS" "$anchor" "$OUT/prefix_first" <<'PYCODE'
import json,sys
from pathlib import Path
from multipath.oracle_schedule import OracleSchedule
from multipath.anchors.development import predecessor_snapshot
s,p,a,root=sys.argv[1:]
try:
    predecessor_snapshot(root,OracleSchedule.load(s).anchors[a].synth_start,json.loads((Path(p)/'manifest.json').read_text())['provenance'])
except (OSError,ValueError,KeyError,StopIteration):
    raise SystemExit(1)
PYCODE
  then predecessor="$OUT/prefix_first"; fi
  run_sim scripts/develop_mounted_anchor.py "${COMMON[@]}" --anchor "$anchor" \
   --predecessor-dir "$predecessor" --artifact-dir "$OUT/anchors" --output-dir "$OUT/$anchor" >"$OUT/$anchor.log" 2>&1 || true
  if [[ "$anchor" == "${ANCHORS[1]}" && -f "$OUT/anchors/$anchor/report.json" ]]; then connect_prefix prefix_with_local_second; fi
 ) &
 PIDS+=("$!")
done
for pid in "${PIDS[@]}"; do wait "$pid" || true; done
if PYTHONPATH="$ROOT/src" "$RUNTIME/envs/retarget/bin/python" - "$MULTIPATH_SCHEDULE" "$OUT/anchors" <<'PYCODE'
import sys
from multipath.oracle_schedule import OracleSchedule
from multipath.anchors.artifact import load_validated_anchor
from pathlib import Path
for a in OracleSchedule.load(sys.argv[1]).anchors.values():load_validated_anchor(Path(sys.argv[2]),a)
PYCODE
then
 run_sim scripts/run_oracle_v0.py "${COMMON[@]}" --validated-anchors "$OUT/anchors" --output-dir "$OUT/final" >"$OUT/final.log" 2>&1 || true
fi
export OUT MULTIPATH_SCHEDULE
"$RUNTIME/envs/retarget/bin/python" - <<'PYCODE'
import json,os
from pathlib import Path
root=Path(os.environ['OUT'])
ids=[a['id'] for a in json.loads(Path(os.environ['MULTIPATH_SCHEDULE']).read_text())['anchors']]
reports={}
for anchor in ids:
    path=root/anchor/'development_result.json'
    reports[anchor]=json.loads(path.read_text()) if path.exists() else {'status':'not_finished','m2_success':False}
final=root/'final/pipeline_result.json'
summary={'local_anchors':reports,'gate_1_passed':bool(reports) and all(r.get('m2_success') for r in reports.values()),
         'gate_2_passed':final.exists() and json.loads(final.read_text()).get('full_pipeline_success',False)}
(root/'gate_report.json').write_text(json.dumps(summary,indent=2))
PYCODE
