#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N oracle_anchor_v0
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H200
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
: "${MULTIPATH_SCHEDULE:?oracle schedule}"
: "${MULTIPATH_TRIPLET:?TACO triplet}"
: "${MULTIPATH_SEQUENCE:?TACO sequence}"
OUT=$ROOT/outputs/${MULTIPATH_RUN_NAME:-oracle_v0_${PBS_JOBID%%.*}}
mkdir -p "$OUT/cache"
cd "$ROOT"
export TACO_ROOT=$RUNTIME/data/taco_v1
export MANO_ROOT=$RUNTIME/sources/reproduction/data/models/mano_smplx
export PYTHONPATH=$ROOT/src:$ENGINE/src
# Human MANO -> local retarget only. Never call the full-video retarget entrypoint.
"$RUNTIME/envs/retarget/bin/python" -u scripts/prepare_oracle_anchors.py \
 --schedule "$MULTIPATH_SCHEDULE" --triplet "$MULTIPATH_TRIPLET" --sequence "$MULTIPATH_SEQUENCE" \
 --mount-report configs/franka_xhand_mount.json --output-dir "$OUT/proposals" >"$OUT/prepare.log" 2>&1
module load singularity
MP_ENV=( --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env "TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib" --env "XDG_CACHE_HOME=$OUT/cache"
 --env "PYTHONPATH=$ROOT/deps:$ROOT/src" --env PYTHONNOUSERSITE=1 --env OMNI_KIT_ACCEPT_EULA=YES
 --env "PBS_JOBID=${PBS_JOBID:-unknown}" )
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
MP_ENV+=(--bind "$ROOT/hpc/container_env/92-env-torch-distributed.sh:/.singularity.d/env/92-env-torch-distributed.sh:ro")
COMMON=( --proposals "$OUT/proposals" --schedule "$MULTIPATH_SCHEDULE"
 --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml"
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" --object-cache "$ENGINE/outputs/sim_usd" )
run_sim() {
 singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u "$@"
}
mapfile -t ANCHORS < <("$RUNTIME/envs/retarget/bin/python" -c 'import json,sys; print("\n".join(a["id"] for a in sorted(json.load(open(sys.argv[1]))["anchors"],key=lambda a:a["core_start"])))' "$MULTIPATH_SCHEDULE")
mkdir -p "$OUT/anchors"
for anchor in "${ANCHORS[@]}"; do
 # Acquire the padded entry by continuous execution of validated predecessors.
 # Stop before the unsynthesized core; never use an unvalidated core as proof.
 run_sim scripts/run_oracle_v0.py "${COMMON[@]}" --validated-anchors "$OUT/anchors" \
  --continue-development --stop-before-anchor "$anchor" --output-dir "$OUT/prefix_$anchor" >"$OUT/prefix_$anchor.log" 2>&1
 run_sim scripts/develop_mounted_anchor.py "${COMMON[@]}" --anchor "$anchor" \
  --predecessor-dir "$OUT/prefix_$anchor" --artifact-dir "$OUT/anchors" --output-dir "$OUT/$anchor" >"$OUT/$anchor.log" 2>&1
done
# A fresh uninterrupted rollout after every padded/core artifact passes.
run_sim scripts/run_oracle_v0.py "${COMMON[@]}" --validated-anchors "$OUT/anchors" \
 --output-dir "$OUT/final" >"$OUT/final.log" 2>&1
