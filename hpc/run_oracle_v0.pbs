#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N oracle_anchor_v0
#PBS -j oe
#PBS -k oed
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H100
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
: "${MULTIPATH_SCHEDULE:?oracle schedule}"
: "${MULTIPATH_TRIPLET:?TACO triplet}"
: "${MULTIPATH_SEQUENCE:?TACO sequence}"
OUT=$ROOT/outputs/${MULTIPATH_RUN_NAME:-oracle_v0_${PBS_JOBID%%.*}}
mkdir -p "$OUT/cache"
cd "$ROOT"
export TACO_ROOT=$RUNTIME/data/taco_v1
export MANO_ROOT=$RUNTIME/sources/reproduction/data/models/mano_smplx
export PYTHONPATH=$ROOT/src:$ENGINE/src
# Human MANO -> local retarget only. Never call the full-video retarget entrypoint.
"$RUNTIME/envs/retarget/bin/python" -u scripts/prepare_oracle_anchors.py \
 --schedule "$MULTIPATH_SCHEDULE" --triplet "$MULTIPATH_TRIPLET" --sequence "$MULTIPATH_SEQUENCE" \
 --mount-report configs/franka_xhand_mount.json --output-dir "$OUT/proposals" >"$OUT/prepare.log" 2>&1
module load singularity
MP_ENV=( --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env "TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib" --env "XDG_CACHE_HOME=$OUT/cache"
 --env "PYTHONPATH=$ROOT/deps:$ROOT/src" --env PYTHONNOUSERSITE=1 --env OMNI_KIT_ACCEPT_EULA=YES
 --env "PBS_JOBID=${PBS_JOBID:-unknown}" )
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u scripts/run_oracle_v0.py \
 --proposals "$OUT/proposals" --schedule "$MULTIPATH_SCHEDULE" \
 --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml" \
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" \
 --object-cache "$ENGINE/outputs/sim_usd" --output-dir "$OUT/development" >"$OUT/run.log" 2>&1

# Fresh world from the original initial scene; no restoring local candidate states.
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u scripts/run_oracle_v0.py \
 --proposals "$OUT/proposals" --schedule "$MULTIPATH_SCHEDULE" --validated-anchors "$OUT/development/anchors" \
 --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml" \
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" \
 --object-cache "$ENGINE/outputs/sim_usd" --output-dir "$OUT/final" >"$OUT/final.log" 2>&1
