#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N oracle_bimanual
#PBS -j oe
#PBS -k oed
#PBS -l walltime=00:20:00
#PBS -l select=1:ncpus=4:mem=20gb:ngpus=1:gpu_model=H200
set -euo pipefail
ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
ENGINE=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
: "${MULTIPATH_RUN_NAME:?unique run name}"
: "${MULTIPATH_SCHEDULE:?static bimanual oracle schedule}"
: "${MULTIPATH_PREPARED_PROPOSALS:?existing local right-hand proposals}"
: "${MULTIPATH_INITIAL_BRIDGE_RUN:?right initial-state predecessor seed}"
: "${MULTIPATH_SEED_ARTIFACTS:?right local Anchor initialization}"
OUT=$ROOT/outputs/$MULTIPATH_RUN_NAME
mkdir -p "$OUT/cache"
cd "$ROOT"
export TACO_ROOT=$RUNTIME/data/taco_v1 MANO_ROOT=$RUNTIME/sources/reproduction/data/models/mano_smplx
export PYTHONPATH=$ROOT/src:$ENGINE/src PYTHONDONTWRITEBYTECODE=1
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
PROPOSALS=${MULTIPATH_SUPPORT_PROPOSALS:-$OUT/proposals}
if [[ -z "${MULTIPATH_SUPPORT_PROPOSALS:-}" ]]; then
PREP_EXTRA=()
[[ -z "${MULTIPATH_EXISTING_SUPPORT_PROPOSALS:-}" ]] || PREP_EXTRA+=(--existing-supporting-proposals "$MULTIPATH_EXISTING_SUPPORT_PROPOSALS")
"$RUNTIME/envs/retarget/bin/python" -u scripts/prepare_supporting_anchors.py \
 --schedule "$MULTIPATH_SCHEDULE" --proposals "$MULTIPATH_PREPARED_PROPOSALS" \
 --object-cache "$ENGINE/outputs/sim_usd" --output-dir "$PROPOSALS" "${PREP_EXTRA[@]}" >"$OUT/prepare.log" 2>&1
fi
source "$ROOT/hpc/stage_torch_imports.sh"
module load singularity
MP_ENV=(--env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
 --env TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib --env "XDG_CACHE_HOME=$OUT/cache"
 --bind "$MULTIPATH_IMPORT_ROOT:$MULTIPATH_IMPORT_ROOT:ro"
 --env "PYTHONPATH=$MULTIPATH_IMPORT_ROOT:$ROOT/deps:$ROOT/src" --env PYTHONDONTWRITEBYTECODE=1 --env PYTHONNOUSERSITE=1
 --env OMNI_KIT_ACCEPT_EULA=YES --env "PBS_JOBID=${PBS_JOBID:-unknown}"
 --env OMP_NUM_THREADS=2 --env OPENBLAS_NUM_THREADS=2 --env MKL_NUM_THREADS=2
 --bind "$ROOT/hpc/container_env/92-env-torch-distributed.sh:/.singularity.d/env/92-env-torch-distributed.sh:ro")
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
EXTRA=()
[[ -z "${MULTIPATH_LEFT_PADDED_CONTROLS:-}" ]] || EXTRA+=(--left-padded-controls "$MULTIPATH_LEFT_PADDED_CONTROLS")
[[ -z "${MULTIPATH_LEFT_PREFIX_RUN:-}" ]] || EXTRA+=(--left-prefix-run "$MULTIPATH_LEFT_PREFIX_RUN")
[[ -z "${MULTIPATH_RIGHT_BOUNDARY_FEEDBACK_RUN:-}" ]] || EXTRA+=(--right-boundary-feedback-run "$MULTIPATH_RIGHT_BOUNDARY_FEEDBACK_RUN")
[[ -z "${MULTIPATH_BRIDGE_FEEDBACK_RUN:-}" ]] || EXTRA+=(--bridge-feedback-run "$MULTIPATH_BRIDGE_FEEDBACK_RUN")
[[ -z "${MULTIPATH_BRIDGE_PHYSICAL_SEED:-}" ]] || EXTRA+=(--bridge-physical-seed "$MULTIPATH_BRIDGE_PHYSICAL_SEED")
[[ -z "${MULTIPATH_BRIDGE_PHYSICS_SECONDS:-}" ]] || EXTRA+=(--bridge-physics-seconds "$MULTIPATH_BRIDGE_PHYSICS_SECONDS")
[[ -z "${MULTIPATH_RIGHT_CORE_RUN:-}" ]] || EXTRA+=(--right-core-run "$MULTIPATH_RIGHT_CORE_RUN")
[[ -z "${MULTIPATH_CARRY_CONTEXT_RUN:-}" ]] || EXTRA+=(--carry-context-run "$MULTIPATH_CARRY_CONTEXT_RUN")
[[ -z "${MULTIPATH_LEFT_PPO_CHECKPOINT:-}" ]] || EXTRA+=(--left-ppo-checkpoint "$MULTIPATH_LEFT_PPO_CHECKPOINT")
[[ -z "${MULTIPATH_LEFT_PPO_SECONDS:-}" ]] || EXTRA+=(--left-ppo-seconds "$MULTIPATH_LEFT_PPO_SECONDS")
[[ "${MULTIPATH_CONTINUE_ORACLE:-0}" != 1 ]] || EXTRA+=(--continue-oracle)
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$RUNTIME/envs/sim-isaac510/bin/python" -u scripts/develop_bimanual_anchor.py \
 --schedule "$MULTIPATH_SCHEDULE" --proposals "$PROPOSALS" --floating-config configs/floating_xhand_bimanual.json \
 --xhand-urdf "$ENGINE/assets/xhand/spider/xhand_right.urdf" --left-xhand-urdf "$ENGINE/assets/xhand/spider/xhand_left.urdf" \
 --object-cache "$ENGINE/outputs/sim_usd" --right-prefix-run "$MULTIPATH_INITIAL_BRIDGE_RUN" \
 --right-anchor-artifacts "$MULTIPATH_SEED_ARTIFACTS" --output-dir "$OUT/physical" "${EXTRA[@]}" >"$OUT/physics.log" 2>&1
