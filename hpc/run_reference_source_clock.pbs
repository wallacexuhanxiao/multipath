#!/bin/bash
#PBS -P CFP04-CF-057
#PBS -q interactive
#PBS -N reference_bc_mp
#PBS -j oe
#PBS -k oed
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=12:mem=120gb:ngpus=1:gpu_model=H100
set -euo pipefail

ROOT=/scratch/e0985859/multipath_v0_fc2da7b
RUNTIME=/scratch/e0985859/egoengine_baseline
IMAGE=/app1/common/singularity-img/hopper/pytorch/pytorch_2.7.0_cuda_12.8.sif
SIM_PY=$RUNTIME/envs/sim-isaac510/bin/python
XHAND=/scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine/assets/xhand/spider/xhand_right.urdf
: "${MULTIPATH_REFERENCE:?Provide the reference NPZ path}"
: "${MULTIPATH_VLM_SCHEDULE:?Provide the upstream VLM output path}"
: "${MULTIPATH_VIDEO:?Provide the source video path}"
OUT=$ROOT/outputs/${MULTIPATH_RUN_NAME:-reference_${PBS_JOBID%%.*}}
mkdir -p "$OUT/cache"
cd "$ROOT"
module load singularity
MP_ENV=(
  --env "LD_LIBRARY_PATH=/scratch/e0985859/semantic_verifier/compat_libs/x11-ubuntu22:/usr/local/cuda/compat/lib:/.singularity.d/libs"
  --env "TRITON_LIBCUDA_PATH=/usr/local/cuda/compat/lib"
  --env "XDG_CACHE_HOME=$OUT/cache"
  --env "PYTHONPATH=$ROOT/deps:$ROOT/src"
  --env PYTHONNOUSERSITE=1
  --env OMNI_KIT_ACCEPT_EULA=YES
  --env "PBS_JOBID=${PBS_JOBID:-unknown}"
)
[[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] || MP_ENV+=(--env "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES")
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$SIM_PY" \
  scripts/compile_reference_schedule.py --reference "$MULTIPATH_REFERENCE" \
  --vlm-schedule "$MULTIPATH_VLM_SCHEDULE" --video "$MULTIPATH_VIDEO" \
  --output "$OUT/generated_schedule.json" >"$OUT/schedule.log" 2>&1
EXTRA_ARGS=()
[[ -z "${MULTIPATH_EXCLUSIONS:-}" ]] || EXTRA_ARGS+=(--path-exclusions "$MULTIPATH_EXCLUSIONS")
singularity exec --nv -e "${MP_ENV[@]}" "$IMAGE" "$SIM_PY" -u \
  scripts/run_mounted_bc_curobo.py --xhand-urdf "$XHAND" \
  --reference "$MULTIPATH_REFERENCE" --schedule "$OUT/generated_schedule.json" \
  --mount-report "$ROOT/configs/franka_xhand_mount.json" \
  --robot-yaml "$ROOT/vendor/curobo-v077/src/curobo/content/configs/robot/franka.yml" \
  --object-cache /scratch/e0985859/dv_xhand_faithful_20260907/vendor/egoengine/outputs/sim_usd \
  --source-clock --source-wrist qpos_right_actual "${EXTRA_ARGS[@]}" \
  --output-dir "$OUT" >"$OUT/run.log" 2>&1
